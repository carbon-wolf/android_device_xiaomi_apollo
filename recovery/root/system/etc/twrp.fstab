# TWRP fstab for Xiaomi apollo (Redmi K30S Ultra / Mi 10T)
# Based on TeamWin android_device_xiaomi_apollo (working decrypt)
# Android fstab file.

#<src>                                                                    <mnt_point>      <type>  <mnt_flags and options>                            <fs_mgr_flags>
system                                                                     /system            ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount
system                                                                     /system            erofs   ro                                                      wait,logical,first_stage_mount
system_ext                                                               /system_ext     ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount
system_ext                                                               /system_ext     erofs   ro                                                      wait,logical,first_stage_mount
product                                                                     /product           ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount
product                                                                     /product           erofs   ro                                                      wait,logical,first_stage_mount
vendor                                                                      /vendor            ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount
vendor                                                                      /vendor            erofs   ro                                                      wait,logical,first_stage_mount
odm                                                                         /odm                ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount
odm                                                                         /odm                erofs   ro                                                      wait,logical,first_stage_mount
#/dev/block/by-name/metadata                                    /metadata         ext4    noatime,nosuid,nodev,discard                         wait,formattable,wrappedkey,first_stage_mount

# TWRP decryption / mounting entries
# mount point  fstype  device                             device2                flags
/metadata          ext4    /dev/block/by-name/metadata                      flags=display="Metadata";wipeingui;backup=1
/data              f2fs    /dev/block/by-name/userdata                      flags=display="Data";wipeingui;backup=1;fileencryption=ice;wrappedkey;keydirectory=/metadata/vold/metadata_encryption
/cache             ext4    /dev/block/by-name/cache                         flags=display="Cache";wipeingui;backup=1
/persist           ext4    /dev/block/by-name/persist                       flags=display="Persist";backup=1
/boot              emmc    /dev/block/by-name/boot                          flags=display="Boot";backup=1;flashimg=1
/recovery          emmc    /dev/block/by-name/recovery                      flags=display="Recovery";backup=1;flashimg=1
/misc              emmc    /dev/block/by-name/misc                          flags=display="Misc"
/exaid             emmc    /dev/block/by-name/exaid                         flags=display="Exaid";backup=1;flashimg=1
/super             emmc    /dev/block/by-name/super                         flags=display="Super";backup=1;flashimg=1
/dtbo              emmc    /dev/block/by-name/dtbo                          flags=display="Dtbo";backup=1;flashimg=1
/vbmeta            emmc    /dev/block/by-name/vbmeta                        flags=display="Vbmeta";backup=1;flashimg=1
/vbmeta_system     emmc    /dev/block/by-name/vbmeta_system                 flags=display="Vbmeta_system";backup=1;flashimg=1

# Firmware
/efs1              emmc    /dev/block/by-name/modemst1                      flags=backup=1;display="EFS"
/efs2              emmc    /dev/block/by-name/modemst2                      flags=backup=1;subpartitionof=/efs1
/efsc              emmc    /dev/block/by-name/fsc                           flags=backup=1;subpartitionof=/efs1
/efsg              emmc    /dev/block/by-name/fsg                           flags=backup=1;subpartitionof=/efs1
/modem             emmc    /dev/block/by-name/modem                         flags=backup=1;display="Modem"
/dsp               emmc    /dev/block/by-name/dsp                           flags=backup=1;subpartitionof=/modem
/bluetooth         emmc    /dev/block/by-name/bluetooth                     flags=backup=1;subpartitionof=/modem
/firmware          vfat    /dev/block/by-name/modem                         flags=display="Firmware";mounttodecrypt;fsflags=ro
/cust              ext4    /dev/block/by-name/cust                          flags=display="Cust";backup=1

# External SD / OTG
/sdcard            vfat    /dev/block/mmcblk0p1                             /dev/block/mmcblk0        flags=display="sdcard";storage;wipeingui;removable
/usb-otg           auto    /dev/block/sdg1                                  /dev/block/sdg            flags=display="usb-otg";storage;wipeingui;removable