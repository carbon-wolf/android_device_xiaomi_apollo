# mount point    fstype    device                                     flags
/metadata        ext4      /dev/block/bootdevice/by-name/metadata     flags=display="metadata";backup=1
/data            f2fs      /dev/block/bootdevice/by-name/userdata     flags=display="Data";fileencryption=ice;keydirectory=/metadata/vold/metadata_encryption;backup=1;wipeingui
/cache           ext4      /dev/block/bootdevice/by-name/cache        flags=display="Cache";backup=1;wipeingui

# 动态分区
/system          ext4      /dev/block/mapper/system                   flags=display="System";logical;backup=1;flashimg=1
/system_ext      ext4      /dev/block/mapper/system_ext               flags=display="System Ext";logical;backup=1;flashimg=1
/vendor          ext4      /dev/block/mapper/vendor                   flags=display="Vendor";logical;backup=1;flashimg=1
/product         ext4      /dev/block/mapper/product                  flags=display="Product";logical;backup=1;flashimg=1
/odm             ext4      /dev/block/mapper/odm                      flags=display="ODM";logical;backup=1;flashimg=1

# 镜像分区
/boot            emmc      /dev/block/bootdevice/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/bootdevice/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1
/dtbo            emmc      /dev/block/bootdevice/by-name/dtbo         flags=display="DTBO";backup=1;flashimg=1
/vbmeta          emmc      /dev/block/bootdevice/by-name/vbmeta       flags=display="vbmeta";backup=1;flashimg=1
/vbmeta_system   emmc      /dev/block/bootdevice/by-name/vbmeta_system flags=display="vbmeta_system";backup=1;flashimg=1

# 其他可备份分区
/persist         ext4      /dev/block/bootdevice/by-name/persist      flags=display="Persist";backup=1
/cust            ext4      /dev/block/bootdevice/by-name/cust         flags=display="Cust";backup=1;flashimg=1
/exaid           emmc      /dev/block/bootdevice/by-name/exaid        flags=display="exaid";backup=1;flashimg=1

# EFS（基带）
/efs1            emmc      /dev/block/bootdevice/by-name/modemst1     flags=display="EFS";backup=1
/efs2            emmc      /dev/block/bootdevice/by-name/modemst2     flags=backup=1;subpartitionof=/efs1
/efsc            emmc      /dev/block/bootdevice/by-name/fsc          flags=backup=1;subpartitionof=/efs1
/efsg            emmc      /dev/block/bootdevice/by-name/fsg          flags=backup=1;subpartitionof=/efs1