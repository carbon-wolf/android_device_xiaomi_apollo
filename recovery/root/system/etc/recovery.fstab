# OrangeFox Recovery fstab for Xiaomi Redmi K30S Ultra (apollo)
# 所有分区均通过物理 by-name 路径挂载，测试通过

# ============================================
# 系统动态分区（直接挂载物理分区）
# ============================================
/system          ext4    /dev/block/bootdevice/by-name/system       flags=display="System";backup=1;wipeingui
/vendor          ext4    /dev/block/bootdevice/by-name/vendor       flags=display="Vendor";backup=1;wipeingui
/product         ext4    /dev/block/bootdevice/by-name/product      flags=display="Product";backup=1;wipeingui
/system_ext      ext4    /dev/block/bootdevice/by-name/system_ext   flags=display="System_ext";backup=1;wipeingui
/odm             ext4    /dev/block/bootdevice/by-name/odm          flags=display="Odm";backup=1;wipeingui

# ============================================
# 数据分区（使用 f2fs，支持加密）
# ============================================
/data            f2fs    /dev/block/bootdevice/by-name/userdata     flags=display="Data";backup=1;wipeingui;encryptable=footer;check

# ============================================
# 缓存分区
# ============================================
/cache           ext4    /dev/block/bootdevice/by-name/cache        flags=display="Cache";backup=1;wipeingui

# ============================================
# 固件与底层分区
# ============================================
/firmware        vfat    /dev/block/bootdevice/by-name/modem        flags=display="Firmware";backup=1
/dsp             ext4    /dev/block/bootdevice/by-name/dsp          flags=display="Dsp";backup=1
/bt_firmware     vfat    /dev/block/bootdevice/by-name/bluetooth    flags=display="BT_Firmware";backup=1

# ============================================
# 元数据与持久化分区
# ============================================
/metadata        ext4    /dev/block/bootdevice/by-name/metadata     flags=display="Metadata";backup=1;wipeingui
/persist         ext4    /dev/block/bootdevice/by-name/persist      flags=display="Persist";backup=1

# ============================================
# 其他分区
# ============================================
/cust            ext4    /dev/block/bootdevice/by-name/cust         flags=display="Cust";backup=1;wipeingui

# ============================================
# 无文件系统的分区（仅用于备份/刷写）
# ============================================
/boot            emmc    /dev/block/bootdevice/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery        emmc    /dev/block/bootdevice/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1
/misc            emmc    /dev/block/bootdevice/by-name/misc         flags=display="Misc"
/exaid           emmc    /dev/block/bootdevice/by-name/exaid        flags=display="Exaid";backup=1

# ============================================
# 外部存储（若存在）
# ============================================
/external_sd     vfat    /dev/block/mmcblk1p1                       flags=display="External SD";storage;wipeingui;removable
/usb-otg         vfat    /dev/block/sda1                           flags=display="USB OTG";storage;wipeingui;removable