# OrangeFox Recovery fstab for Xiaomi Redmi K30S Ultra / Mi 10T/Pro (apollo)

# 动态分区：需要先挂载 super 分区
/super           emmc    /dev/block/bootdevice/by-name/super               flags=display="Super";backup=1

# 动态分区内的子分区（通过 super 挂载）
/system          ext4    /dev/block/bootdevice/by-name/system              flags=display="System";backup=1;subpartition=/super
/vendor          ext4    /dev/block/bootdevice/by-name/vendor              flags=display="Vendor";backup=1;subpartition=/super
/product         ext4    /dev/block/bootdevice/by-name/product             flags=display="Product";backup=1;subpartition=/super
/system_ext      ext4    /dev/block/bootdevice/by-name/system_ext          flags=display="System_ext";backup=1;subpartition=/super
/odm             ext4    /dev/block/bootdevice/by-name/odm                 flags=display="Odm";backup=1;subpartition=/super

# 数据分区：支持解密，使用 f2fs 文件系统
/data            f2fs    /dev/block/bootdevice/by-name/userdata            flags=display="Data";backup=1;wipeingui;encryptable=footer;check
# 如果内核不支持 f2fs，可将上面一行改为 ext4 版本：
# /data          ext4    /dev/block/bootdevice/by-name/userdata            flags=display="Data";backup=1;wipeingui;encryptable=footer;check

# 缓存分区
/cache           ext4    /dev/block/bootdevice/by-name/cache               flags=display="Cache";backup=1;wipeingui

# 固件与底层分区
/firmware        vfat    /dev/block/bootdevice/by-name/modem               flags=display="Firmware";backup=1
/dsp             ext4    /dev/block/bootdevice/by-name/dsp                 flags=display="Dsp";backup=1
/bt_firmware     vfat    /dev/block/bootdevice/by-name/bluetooth           flags=display="BT_Firmware";backup=1

# 元数据与持久化分区
/metadata        ext4    /dev/block/bootdevice/by-name/metadata            flags=display="Metadata";backup=1;wipeingui
/persist         ext4    /dev/block/bootdevice/by-name/persist             flags=display="Persist";backup=1

# 引导与恢复核心分区
/boot            emmc    /dev/block/bootdevice/by-name/boot                flags=display="Boot";backup=1
/recovery        emmc    /dev/block/bootdevice/by-name/recovery            flags=display="Recovery";backup=1
/misc            emmc    /dev/block/bootdevice/by-name/misc                flags=display="Misc"

# 外部存储（SD卡/OTG）
/external_sd     vfat    /dev/block/mmcblk1p1                              flags=display="External SD";storage;wipeingui;removable
/usb-otg         vfat    /dev/block/sda1                                  flags=display="USB OTG";storage;wipeingui;removable

# 其他分区（如有需要可保留）
/cust            ext4    /dev/block/bootdevice/by-name/cust                flags=display="Cust";backup=1;wipeingui